<file path="scripts/README.md">
# scripts/

## Descripción
Scripts de utilidad que NO son parte de la app en runtime. Se ejecutan manualmente con `npm run`.

## Archivos de este directorio
| Archivo | Función |
|---|---|
| `sync-products.js` | Escanea `public/products/*/`, parsea cada `data.txt`, lista las fotos y genera `public/products/manifest.json`. Ejecutar con `npm run sync` cada vez que se agregue/modifique un producto. |
| `fix-images.js` | Adapta las imágenes a los contenedores donde se muestran (sin recortarlas): productos → `1200x1200` con fondo crema (`#FFFBF0`); hero → `1920x1080` con la misma imagen desenfocada de fondo. Respalda los originales en `.backup-imagenes/` (no commitear). Ejecutar con `npm run fix:images`. Requiere ImageMagick (`magick`). |

## Cómo funciona `sync-products.js`
1. Lee todas las carpetas dentro de `public/products/`.
2. Por cada carpeta:
   - Lee `data.txt` y parsea `nombre`, `descripcion`, `precio`, `subtipos` y `terminaciones` (opcional; adicional que se suma al precio del subtipo, ej: `Bañado | 2000`).
   - Lista archivos de imagen (`.jpg`, `.jpeg`, `.png`, `.webp`, `.avif`) y los ordena numéricamente.
3. Escribe el array resultante en `public/products/manifest.json`.
</file>

<file path="scripts/sync-products.js">
import { readdirSync, readFileSync, writeFileSync, existsSync, statSync } from 'node:fs'
import { join } from 'node:path'
import { fileURLToPath } from 'node:url'
import { dirname } from 'node:path'

const __dirname = dirname(fileURLToPath(import.meta.url))
const PRODUCTS_DIR = join(__dirname, '..', 'public', 'products')
const MANIFEST_PATH = join(PRODUCTS_DIR, 'manifest.json')
const IMG_EXTENSIONS = /\.(jpg|jpeg|png|webp|avif|gif|svg)$/i

function naturalCompare(a, b) {
  const ax = [], bx = []
  a.replace(/(\d+)|(\D+)/g, (_, $1, $2) => ax.push([$1 || Infinity, $2 || '']))
  b.replace(/(\d+)|(\D+)/g, (_, $1, $2) => bx.push([$1 || Infinity, $2 || '']))
  while (ax.length && bx.length) {
    const an = ax.shift(), bn = bx.shift()
    const nn = (an[0] - bn[0]) || an[1].localeCompare(bn[1])
    if (nn) return nn
  }
  return ax.length - bx.length
}

function parseDataTxt(content) {
  const lines = content.split(/\r?\n/)
  const result = {
    nombre: '',
    descripcion: '',
    precio: 0,
    subtipos: [],
    terminaciones: [],
  }
  let inSubtipos = false
  let inTerminaciones = false

  for (const rawLine of lines) {
    const line = rawLine.trim()
    if (!line) {
      if (inSubtipos) inSubtipos = false
      if (inTerminaciones) inTerminaciones = false
      continue
    }

    if (line.toLowerCase().startsWith('subtipos:')) {
      inSubtipos = true
      inTerminaciones = false
      continue
    }

    if (line.toLowerCase().startsWith('terminaciones:')) {
      inTerminaciones = true
      inSubtipos = false
      continue
    }

    if (inSubtipos || inTerminaciones) {
      const parts = line.split('|').map((p) => p.trim())
      if (parts.length >= 2) {
        const precio = parseInt(parts[1].replace(/\D/g, ''), 10)
        if (!isNaN(precio)) {
          if (inSubtipos) result.subtipos.push({ nombre: parts[0], precio })
          else result.terminaciones.push({ nombre: parts[0], precio })
        }
      }
      continue
    }

    const colonIdx = line.indexOf(':')
    if (colonIdx === -1) continue

    const key = line.slice(0, colonIdx).trim().toLowerCase()
    const value = line.slice(colonIdx + 1).trim()

    if (key === 'nombre') result.nombre = value
    else if (key === 'descripcion') result.descripcion = value
    else if (key === 'precio') {
      const n = parseInt(value.replace(/\D/g, ''), 10)
      if (!isNaN(n)) result.precio = n
    }
  }

  return result
}

function scanProductFolder(slug) {
  const folder = join(PRODUCTS_DIR, slug)
  const dataPath = join(folder, 'data.txt')

  if (!existsSync(dataPath)) {
    console.warn(`[skip] ${slug}: falta data.txt`)
    return null
  }

  const dataContent = readFileSync(dataPath, 'utf-8')
  const parsed = parseDataTxt(dataContent)

  const allFiles = readdirSync(folder)
  const images = allFiles
    .filter((f) => IMG_EXTENSIONS.test(f))
    .sort(naturalCompare)
    .map((f) => `/products/${slug}/${f}`)

  if (images.length === 0) {
    console.warn(`[warn] ${slug}: no tiene imágenes`)
  }

  return {
    slug,
    nombre: parsed.nombre || slug,
    descripcion: parsed.descripcion || '',
    precio: parsed.precio,
    subtipos: parsed.subtipos,
    terminaciones: parsed.terminaciones,
    imagenes: images,
  }
}

function main() {
  if (!existsSync(PRODUCTS_DIR)) {
    console.error(`No existe ${PRODUCTS_DIR}`)
    process.exit(1)
  }

  const entries = readdirSync(PRODUCTS_DIR, { withFileTypes: true })
  const productFolders = entries
    .filter((e) => e.isDirectory())
    .map((e) => e.name)

  const products = []
  for (const slug of productFolders) {
    const product = scanProductFolder(slug)
    if (product) products.push(product)
  }

  writeFileSync(MANIFEST_PATH, JSON.stringify(products, null, 2), 'utf-8')
  console.log(`✓ manifest.json generado con ${products.length} producto(s)`)
  for (const p of products) {
    console.log(`  - ${p.slug} (${p.imagenes.length} img, ${p.subtipos.length} subtipos, ${p.terminaciones.length} terminaciones)`)
  }
}

main()
</file>

